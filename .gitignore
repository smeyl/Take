.DS_Store
__pycache__/
*.pyc

# Runtime data — keep the folders, ignore their contents
/recordings/*
/incoming/*
!/recordings/.gitkeep
!/incoming/.gitkeep

# Runtime logs — keep the tail script, ignore the log files
/logs/*.log
node_modules/

# Generated icon artifacts — keep make_icons.py, ignore its output
assets/*.png
assets/*.icns
assets/*.iconset


# Xcode build output of the artist app — never committed. The app a fresh
# clone runs is artist-app/prebuilt/Take.app (refresh it: artist-app/build_prebuilt.sh).
artist-app/Take/Builds/MacOSX/build/
