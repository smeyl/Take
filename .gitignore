.DS_Store
__pycache__/
*.pyc

# Runtime data — keep the folders, ignore their contents
/recordings/*
/incoming/*
!/recordings/.gitkeep
!/incoming/.gitkeep

# Runtime logs — keep the tail script, ignore the log files
/logs/*.log
node_modules/

# Generated icon artifacts — keep make_icons.py, ignore its output
assets/*.png
assets/*.icns
assets/*.iconset

# Xcode build intermediates (regenerated on every build) — never commit these.
artist-app/Take/Builds/MacOSX/build/Take.build/
artist-app/Take/Builds/MacOSX/build/XCBuildData/
# Compiled artist app — untracked; build it locally with xcodebuild (see
# artist-app/Take/Builds/MacOSX) or launch via start_take_artist.sh after building.
artist-app/Take/Builds/MacOSX/build/Debug/Take.app
