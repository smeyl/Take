#!/bin/bash
# One Terminal window: backend runs in the background (&), then the Electron
# UI runs in the foreground. Everything visible in a single tab.
osascript <<'EOF'
tell application "Terminal"
    do script "cd ~/Desktop/Take/backend && ./dev_engineer.sh & sleep 5 && cd ~/Desktop/Take/engineer-app && npm start"
end tell
EOF

exit 0
