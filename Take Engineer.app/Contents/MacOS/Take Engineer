#!/bin/bash
# Launch the engineer backend + Electron UI with no visible Terminal windows.
# Everything runs detached and logs to ~/Desktop/Take/logs/.
TAKE_DIR="$HOME/Desktop/Take"
LOGS="$TAKE_DIR/logs"
mkdir -p "$LOGS"

# Finder launches bundles with a minimal PATH; make sure node/npm are findable.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Python services (relay + engineer backend)
cd "$TAKE_DIR/backend" && nohup ./dev_engineer.sh >> "$LOGS/engineer.log" 2>&1 &
disown

# Electron UI (also runs the Vite dev server) — appears in the Dock on its own
cd "$TAKE_DIR/engineer-app" && nohup npm start >> "$LOGS/electron.log" 2>&1 &
disown

exit 0
