#!/bin/bash
# One Terminal window: backend runs in the background (&), then the Electron
# UI runs in the foreground. Everything visible in a single tab.
#
# The repo root is derived from this bundle's location (the .app lives at the
# repo root), so the clone can be anywhere — not just ~/Desktop/Take.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"

osascript <<EOF
tell application "Terminal"
    do script "cd \"$ROOT/backend\" && ./dev_engineer.sh & sleep 5 && cd \"$ROOT/engineer-app\" && npm start"
end tell
EOF

exit 0
