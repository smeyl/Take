#!/bin/bash
# Launch the artist backend + native JUCE app with no visible Terminal windows.
# The backend runs detached and logs to ~/Desktop/Take/logs/.
TAKE_DIR="$HOME/Desktop/Take"
BACKEND="$TAKE_DIR/backend"
LOGS="$TAKE_DIR/logs"
mkdir -p "$LOGS"

# Python services (transport, stream, receivers). Invoke with an explicit
# /bin/bash and absolute path so Gatekeeper's "Operation not permitted" on
# ./script.sh (and any cwd quirks) can't block the launch.
nohup /bin/bash "$BACKEND/dev_artist.sh" >> "$LOGS/artist.log" 2>&1 &
disown

# Native JUCE app — `open` returns immediately and puts it in the Dock
open "$TAKE_DIR/artist-app/Take/Builds/MacOSX/build/Debug/Take.app"

exit 0
