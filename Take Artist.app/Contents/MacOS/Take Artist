#!/bin/bash
# One Terminal window: backend runs in the background (&), then the native
# JUCE app is opened. Everything visible in a single tab.
osascript <<'EOF'
tell application "Terminal"
    do script "cd ~/Desktop/Take/backend && ./dev_artist.sh & sleep 3 && open ~/Desktop/Take/artist-app/Take/Builds/MacOSX/build/Debug/Take.app"
end tell
EOF

exit 0
